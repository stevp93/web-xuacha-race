{
  "name": "Xuacha Race - Cobro: WhatsApp y mantenimiento",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "name": "Cada 2 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "xuacha-outbox",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Aviso de la API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "xuacha-outbox"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "name": "Cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        460
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "apiBase",
              "type": "string",
              "value": "https://bxtmachwamcfugodthef.supabase.co/functions/v1/api"
            },
            {
              "id": "c2",
              "name": "internalApiKey",
              "type": "string",
              "value": "PEGAR_INTERNAL_API_KEY"
            },
            {
              "id": "c3",
              "name": "evolutionUrl",
              "type": "string",
              "value": "https://TU-EVOLUTION-API"
            },
            {
              "id": "c4",
              "name": "evolutionInstance",
              "type": "string",
              "value": "Asistente SPA"
            },
            {
              "id": "c5",
              "name": "evolutionApiKey",
              "type": "string",
              "value": "PEGAR_APIKEY_DE_LA_INSTANCIA"
            }
          ]
        },
        "options": {}
      },
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.apiBase }}/internal/outbox/due?limit=20",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.internalApiKey }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Leer cola",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "messages",
        "options": {}
      },
      "name": "Dividir mensajes",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        720,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.evolutionUrl }}/message/sendText/{{ encodeURIComponent($('Config').first().json.evolutionInstance) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.evolutionApiKey }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.number, text: $json.text }) }}"
      },
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        100
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": false
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.apiBase }}/internal/outbox/{{ $('Dividir mensajes').item.json.id }}/ack",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.internalApiKey }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ok: true }) }}"
      },
      "name": "Confirmar envio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.apiBase }}/internal/outbox/{{ $('Dividir mensajes').item.json.id }}/ack",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.internalApiKey }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ok: false, error: ($json.error && $json.error.message) || 'fallo de entrega' }) }}"
      },
      "name": "Reportar fallo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://bxtmachwamcfugodthef.supabase.co/functions/v1/api/internal/cron",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer PEGAR_INTERNAL_API_KEY"
            }
          ]
        },
        "options": {}
      },
      "name": "Mantenimiento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        460
      ]
    }
  ],
  "connections": {
    "Cada 2 minutos": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aviso de la API": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Leer cola",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Leer cola": {
      "main": [
        [
          {
            "node": "Dividir mensajes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dividir mensajes": {
      "main": [
        [
          {
            "node": "Enviar WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar WhatsApp": {
      "main": [
        [
          {
            "node": "Confirmar envio",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reportar fallo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cada hora": {
      "main": [
        [
          {
            "node": "Mantenimiento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}