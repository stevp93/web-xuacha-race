# Copiar a .env (servidor propio) o cargar con `supabase secrets set --env-file .env` (Supabase).
# Nunca subir el archivo real al repositorio: el sitio es público en GitHub Pages.

# --- Base de datos ---
# En Supabase Edge Functions NO hace falta: la plataforma define SUPABASE_DB_URL.
# En el servidor de respaldo: cadena de conexión de Supabase (Session pooler) para usar la misma base.
DATABASE_URL=postgres://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Sitio ---
EVENT_ID=xr2027
SITE_URL=https://www.xuacharace.com
ALLOWED_ORIGINS=https://www.xuacharace.com,https://xuacharace.com

# --- Wompi (Comercios > Desarrolladores) ---
# Sandbox: llaves pub_test_/prv_test_ y https://sandbox.wompi.co/v1
# Producción: llaves pub_prod_/prv_prod_ y https://production.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENTS_SECRET=test_events_xxx
WOMPI_API_BASE=https://sandbox.wompi.co/v1

# --- Llaves propias (generar con: openssl rand -hex 32) ---
INTERNAL_API_KEY=
ADMIN_API_KEY=

# --- Opcionales ---
# Webhook de n8n para entrega inmediata (sin esto, n8n entrega en su siguiente sondeo).
N8N_WEBHOOK_URL=
# Secreto de Cloudflare Turnstile; si se define, el paso 1 exige el desafío anti-bot.
TURNSTILE_SECRET=

# --- Solo servidor propio ---
PORT=8787
